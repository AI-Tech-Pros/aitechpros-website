# OrchestrateOS API — copy to .env and adjust
API_PORT=8000
LOG_LEVEL=info

# Default stack: SQLite on a Docker volume
DATABASE_URL=sqlite:////data/resume_engine.db

# Postgres stack (docker compose --profile postgres up api-postgres):
# DATABASE_URL=postgresql+psycopg2://resume:resume@postgres:5432/resume_engine

# Comma-separated browser origins for the product landing page
CORS_ORIGINS=https://orchestrateos.aitechpros.ai,http://localhost:3001,http://127.0.0.1:3001
